# Copia este archivo como «config_ia.env» en esta misma carpeta y rellena
# los datos. El servidor lo lee automáticamente al arrancar.
#
# Opción recomendada: Google AI Studio (tiene un nivel gratuito).
#   1. Entra en https://aistudio.google.com/apikey y crea una clave de API.
#   2. Pega la clave abajo.
#   3. Arranca la web con doble clic en «iniciar.command».
#
# Si tu cuenta no tiene el modelo indicado, cambia LOGICA_IA_MODEL por otro
# modelo disponible. La lista de modelos cambia con el tiempo; puedes verla
# en https://ai.google.dev/gemini-api/docs/models

LOGICA_IA_URL=https://generativelanguage.googleapis.com/v1beta/openai
LOGICA_IA_MODEL=gemini-3.8-flash
LOGICA_IA_KEY=pon-aqui-tu-clave

# 1 = antes de preguntar a la IA, busca las frases en DuckDuckGo y le pasa
# los resultados como contexto. 0 = no busca en internet.
LOGICA_BUSQUEDA=1

# Tiempo máximo de espera del servicio de IA, en segundos.
LOGICA_IA_TIMEOUT=25
